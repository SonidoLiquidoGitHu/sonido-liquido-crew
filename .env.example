# ===========================================
# SONIDO LIQUIDO CREW - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values
# Do NOT commit .env.local to version control

# ===========================================
# REQUIRED - Core Application
# ===========================================

# NextAuth configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=file:./data/sonido-liquido.db

# ===========================================
# REQUIRED - Spotify API
# ===========================================
# Get credentials at: https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===========================================
# REQUIRED - YouTube Data API
# ===========================================
# Get credentials at: https://console.cloud.google.com/apis

YOUTUBE_API_KEY=

# ===========================================
# REQUIRED - Dropbox API
# ===========================================
# Get credentials at: https://www.dropbox.com/developers/apps

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=

# ===========================================
# OPTIONAL - Admin Authentication
# ===========================================
# Default admin credentials for initial setup
# Change these immediately in production

ADMIN_EMAIL=admin@sonidoliquido.com
ADMIN_PASSWORD=changeme123

# ===========================================
# OPTIONAL - Stripe (E-commerce)
# ===========================================
# Get credentials at: https://dashboard.stripe.com/apikeys
# Leave empty to disable e-commerce features

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================================
# OPTIONAL - Mailchimp (Email Marketing)
# ===========================================
# Get credentials at: https://admin.mailchimp.com/account/api/
# Leave empty to disable Mailchimp integration

MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# ===========================================
# OPTIONAL - Site Configuration
# ===========================================

# Site URL for production
NEXT_PUBLIC_SITE_URL=https://sonidoliquido.com

# Contact information
NEXT_PUBLIC_CONTACT_EMAIL=prensasonidoliquido@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=5528011881

# Social media links
NEXT_PUBLIC_SPOTIFY_URL=https://open.spotify.com/playlist/5qHTKCZIwi3GM3mhPq45Ab
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@sonidoliquidocrew
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/sonidoliquido/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/sonidoliquidocrew/

# ===========================================
# OPTIONAL - Sync Configuration
# ===========================================

# Sync intervals in minutes (default: 60)
SYNC_INTERVAL_SPOTIFY=60
SYNC_INTERVAL_YOUTUBE=120
SYNC_INTERVAL_DROPBOX=180

# ===========================================
# OPTIONAL - Push Notifications (VAPID)
# ===========================================
# Generate VAPID keys with: npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:prensasonidoliquido@gmail.com

# ===========================================
# OPTIONAL - Feature Flags
# ===========================================

# Enable/disable features
FEATURE_ECOMMERCE=false
FEATURE_MAILCHIMP=false
FEATURE_DOWNLOAD_GATES=true
FEATURE_BEATS_GALLERY=true
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_AB_TESTING=true

# ===========================================
# OPTIONAL - Meta API (Social Auto-Posting)
# ===========================================
# Get credentials at: https://developers.facebook.com/apps/
# Required for automated posting to Facebook Page and Instagram
# System User token never expires (no manual refresh needed)

META_APP_ID=1275591631445313
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
FACEBOOK_PAGE_ID=163429477044436

# ===========================================
# OPTIONAL - Runway AI (Video Generation)
# ===========================================
# Get API key at: https://app.runwayml.com/settings/api-keys
# Used for AI-powered marketing video generation from album covers
# Store as Netlify env var for production

RUNWAYML_API_SECRET=

# ===========================================
# OPTIONAL - TikTok Content Posting API
# ===========================================
# Get credentials at: https://developers.tiktok.com/
# Required for automated posting to TikTok

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# ===========================================
# OPTIONAL - Catalogue Access Key (AI agent gate)
# ===========================================
# The /catalogo page and /api/catalogue endpoint expose the full
# Sonido Líquido knowledge base (artists, releases, videos, events,
# beats, playlists, gallery, timeline) for AI agents to query.
#
# By default these endpoints are NOT linked from the public nav and
# are blocked from search engine indexing via robots.txt + noindex meta.
#
# To gate access behind a secret key, set this variable. When set:
#   - /catalogo?key=VALUE       → 200 OK (HTML)
#   - /catalogo (no key)        → 404 Not Found
#   - /api/catalogue?key=VALUE  → 200 OK (JSON)
#   - /api/catalogue (no key)   → 404 Not Found
#   - Or pass via header: x-catalogo-key: VALUE
#
# When UNSET, both endpoints are public (dev mode only — a warning
# is logged in production if the var is missing).
#
# Generate a strong key with:  openssl rand -hex 32

CATALOGO_ACCESS_KEY=
